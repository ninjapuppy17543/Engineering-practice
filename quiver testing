import matplotlib.pyplot as plt
import numpy as np

plt.xlim(-5, 5)
plt.ylim(-5, 5)

plt.axhline(y=0, zorder=0, color="black", alpha=0.3)
plt.axvline(x=0, zorder=0, color="black", alpha=0.3)

xpos = 0
ypos = 0
u = 3
v = 1

plt.grid(linewidth=2,
         color="lightgray",
         alpha=0.2,
         zorder=0)

plt.scatter(3, 1)
plt.scatter(0, 0)

plt.quiver(xpos, ypos, u, v, color="darkred", scale=1, angles="xy", scale_units="xy")

plt.xticks(range(-5, 6))
plt.yticks(range(-5, 6))

plt.show()